{
  "name": "loom-ui",
  "version": "0.1.0",
  "description": "A canvas UI engine and a UI language designed for AI models to write.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/loom.js",
  "module": "./dist/loom.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/loom.js"
    },
    "./map": {
      "types": "./dist/types/components/map/index.d.ts",
      "import": "./dist/map.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/testing.js"
    },
    "./model": {
      "types": "./dist/types/model/index.d.ts",
      "import": "./dist/model.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:playground": "vite build --config vite.playground.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:world": "node scripts/build-world.mjs",
    "docs:components": "vite-node scripts/gen-component-docs.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:docker": "docker run --rm --ipc=host -v \"$PWD\":/work -v /work/node_modules -w /work mcr.microsoft.com/playwright:v1.56.1-noble /bin/bash -c \"npm ci && npx playwright test $VISUAL_ARGS\"",
    "bench": "vitest bench --run",
    "docs:check": "vite-node scripts/gen-component-docs.ts --check",
    "new:component": "vite-node scripts/new-component.ts --",
    "eval": "vite-node scripts/eval.ts --",
    "guide:size": "vite-node scripts/guide-size.ts",
    "site:docs": "vite-node scripts/gen-site-docs.ts",
    "site:dev": "npm run site:docs && npm --prefix site run dev",
    "site:build": "npm run site:docs && npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "site:check": "node scripts/check-site.mjs"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.9.0",
    "d3-geo": "^3.1.1",
    "fast-check": "4.3.0",
    "topojson-client": "^3.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-node": "^2.1.4",
    "vitest": "2.1.4",
    "world-atlas": "^2.0.2"
  }
}
