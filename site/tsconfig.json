{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node", "vite/client"],
    "paths": { "@loom/*": ["../src/*"] }
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "examples/**/*.ts"]
}
