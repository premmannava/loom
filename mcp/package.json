{
  "name": "sayshape-mcp",
  "version": "0.1.0",
  "description": "An MCP server that lets Claude, ChatGPT and other MCP Apps clients show SayShape interfaces inside the chat.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sayshape-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --config vite.ui.config.ts && node scripts/inline-ui.mjs && vite build --config vite.server.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
